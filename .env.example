APP_NAME=JobsRSS
APP_VERSION=2.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://jobsrss:jobsrss@postgres:5432/jobsrss
RSS_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SCHEDULER_ENABLED=true
SCHEDULER_COMPANY_INTERVAL_MINUTES=20
SCHEDULER_PLATFORM_INTERVAL_MINUTES=20
SCHEDULER_LINKEDIN_EMAIL_INTERVAL_MINUTES=15
HIGH_MATCH_THRESHOLD=80
OFFICIAL_SOURCES_ENABLED=true
OFFICIAL_SOURCE_INTERVAL_MINUTES=360
OFFICIAL_SOURCE_TIMEOUT_SECONDS=30
OFFICIAL_SOURCE_MAX_JOBS_PER_SOURCE=50
OFFICIAL_SOURCE_MAX_PAGES_PER_SOURCE=10
OFFICIAL_SOURCE_STALE_AFTER_DAYS=30
OFFICIAL_SOURCE_VERIFY_TLS=true
LLM_RERANK_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=
LLM_AZURE_USE_DEFAULT_CREDENTIAL=false
LLM_AZURE_SCOPE=https://ai.azure.com/.default
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=30
LLM_VERIFY_TLS=true
LLM_REQUEST_MAX_RETRIES=2
LLM_REQUEST_RETRY_BACKOFF_SECONDS=1.5
LLM_ABORT_AFTER_CONSECUTIVE_FAILURES=8
LLM_RERANK_INTERVAL_MINUTES=30
LLM_MAX_JOBS_PER_RUN=60
LLM_MIN_RULE_SCORE=20
LLM_ONLY_UNSCORED=true
LLM_REJECT_EARLY_CAREER=true
LLM_TARGET_PROFILE=Senior cybersecurity roles focused on cloud security, application security, IAM/PAM, SOC/SIEM, threat detection, vulnerability management, and security architecture leadership across Shanghai/Jiangsu/Zhejiang (Yangtze River Delta), Hong Kong, and Singapore.

LINKEDIN_EMAIL_ENABLED=false
LINKEDIN_EMAIL_IMAP_HOST=imap.gmail.com
LINKEDIN_EMAIL_IMAP_PORT=993
LINKEDIN_EMAIL_USERNAME=jobs-alert@example.com
LINKEDIN_EMAIL_PASSWORD=your_app_password
LINKEDIN_EMAIL_FOLDER=INBOX
LINKEDIN_EMAIL_SENDER_FILTER=jobs-noreply@linkedin.com
SCHEDULER_LINKEDIN_EMAIL_MAX_MESSAGES=30

LINKEDIN_AUTH_ENABLED=false
LINKEDIN_AUTH_USERNAME=
LINKEDIN_AUTH_PASSWORD=
LINKEDIN_AUTH_STORAGE_STATE_PATH=
LINKEDIN_REQUIRE_STORAGE_STATE=true
LINKEDIN_SEARCH_URLS=https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security&location=Singapore,https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security&location=Hong%20Kong,https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security&location=Shanghai%2C%20China,https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security&location=Hangzhou%2C%20Zhejiang%2C%20China
LINKEDIN_POLLING_INTERVAL_MINUTES=20
LINKEDIN_AUTH_STALE_AFTER_DAYS=14
LINKEDIN_EXTERNAL_ENRICHMENT_ENABLED=true
LINKEDIN_EXTERNAL_ENRICHMENT_TIMEOUT_SECONDS=20
LINKEDIN_STRICT_LOCATION_FILTER=true
LINKEDIN_ALLOWED_LOCATIONS=Singapore,Hong Kong,Shanghai,Jiangsu,Zhejiang

JOB51_AUTH_ENABLED=false
JOB51_AUTH_USERNAME=
JOB51_AUTH_PASSWORD=
JOB51_AUTH_STORAGE_STATE_PATH=
JOB51_SEARCH_URLS=
JOB51_POLLING_INTERVAL_MINUTES=20

LIEPIN_AUTH_ENABLED=false
LIEPIN_AUTH_USERNAME=
LIEPIN_AUTH_PASSWORD=
LIEPIN_AUTH_STORAGE_STATE_PATH=
LIEPIN_SEARCH_URLS=
LIEPIN_POLLING_INTERVAL_MINUTES=20

DIGEST_EMAIL_ENABLED=false
DIGEST_EMAIL_SMTP_HOST=
DIGEST_EMAIL_SMTP_PORT=587
DIGEST_EMAIL_SMTP_USERNAME=
DIGEST_EMAIL_SMTP_PASSWORD=
DIGEST_EMAIL_SENDER=
DIGEST_EMAIL_RECIPIENTS=
DIGEST_EMAIL_USE_TLS=true
SCHEDULER_DIGEST_HOUR_UTC=1
SCHEDULER_DIGEST_MINUTE_UTC=0
