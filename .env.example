APP_NAME=JobsRSS
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://jobsrss:jobsrss@postgres:5432/jobsrss
RSS_BASE_URL=http://localhost:8000
SCHEDULER_ENABLED=true
SCHEDULER_COMPANY_INTERVAL_MINUTES=20
SCHEDULER_PLATFORM_INTERVAL_MINUTES=20
SCHEDULER_LINKEDIN_EMAIL_INTERVAL_MINUTES=15
HIGH_MATCH_THRESHOLD=80

LINKEDIN_EMAIL_ENABLED=false
LINKEDIN_EMAIL_IMAP_HOST=imap.gmail.com
LINKEDIN_EMAIL_IMAP_PORT=993
LINKEDIN_EMAIL_USERNAME=jobs-alert@example.com
LINKEDIN_EMAIL_PASSWORD=your_app_password
LINKEDIN_EMAIL_FOLDER=INBOX
LINKEDIN_EMAIL_SENDER_FILTER=jobs-noreply@linkedin.com
SCHEDULER_LINKEDIN_EMAIL_MAX_MESSAGES=30

LINKEDIN_AUTH_ENABLED=false
LINKEDIN_AUTH_USERNAME=
LINKEDIN_AUTH_PASSWORD=
LINKEDIN_AUTH_STORAGE_STATE_PATH=
LINKEDIN_SEARCH_URLS=
LINKEDIN_POLLING_INTERVAL_MINUTES=20

JOB51_AUTH_ENABLED=false
JOB51_AUTH_USERNAME=
JOB51_AUTH_PASSWORD=
JOB51_AUTH_STORAGE_STATE_PATH=
JOB51_SEARCH_URLS=
JOB51_POLLING_INTERVAL_MINUTES=20

LIEPIN_AUTH_ENABLED=false
LIEPIN_AUTH_USERNAME=
LIEPIN_AUTH_PASSWORD=
LIEPIN_AUTH_STORAGE_STATE_PATH=
LIEPIN_SEARCH_URLS=
LIEPIN_POLLING_INTERVAL_MINUTES=20

DIGEST_EMAIL_ENABLED=false
DIGEST_EMAIL_SMTP_HOST=
DIGEST_EMAIL_SMTP_PORT=587
DIGEST_EMAIL_SMTP_USERNAME=
DIGEST_EMAIL_SMTP_PASSWORD=
DIGEST_EMAIL_SENDER=
DIGEST_EMAIL_RECIPIENTS=
DIGEST_EMAIL_USE_TLS=true
SCHEDULER_DIGEST_HOUR_UTC=1
SCHEDULER_DIGEST_MINUTE_UTC=0
