# Runtime metadata
APP_NAME=JobsRSS
APP_VERSION=2.1.0
ENVIRONMENT=production

# App endpoints
RSS_BASE_URL=https://jobs.example.com
ALLOWED_ORIGINS=["https://jobs.example.com"]

# Service ports (host -> container)
API_PORT=8000
FRONTEND_PORT=3000

# Postgres in compose
POSTGRES_USER=jobsrss
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jobsrss
DATABASE_URL=postgresql+psycopg2://jobsrss:CHANGE_ME@postgres:5432/jobsrss

# Scheduler and source toggles
SCHEDULER_ENABLED=true
OFFICIAL_SOURCES_ENABLED=true
OFFICIAL_SOURCE_INTERVAL_MINUTES=360
OFFICIAL_SOURCE_VERIFY_TLS=true

# LinkedIn/Liepin collection
LINKEDIN_AUTH_ENABLED=true
LINKEDIN_AUTH_STORAGE_STATE_PATH=/secrets/linkedin_state.json
LINKEDIN_REQUIRE_STORAGE_STATE=true
LINKEDIN_STRICT_LOCATION_FILTER=true
LINKEDIN_ALLOWED_LOCATIONS=Singapore,Hong Kong,Shanghai,Jiangsu,Zhejiang
LINKEDIN_SEARCH_URLS=

LIEPIN_AUTH_ENABLED=true
LIEPIN_AUTH_STORAGE_STATE_PATH=/secrets/liepin_state.json
LIEPIN_SEARCH_URLS=

# Optional LLM rerank
LLM_RERANK_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_VERIFY_TLS=true
LLM_REQUEST_MAX_RETRIES=2
LLM_REQUEST_RETRY_BACKOFF_SECONDS=1.5
LLM_ABORT_AFTER_CONSECUTIVE_FAILURES=8

# Frontend -> backend routing in container network
BACKEND_API_BASE_URLS=http://api:8000
