APP_NAME=JobsRSS
APP_VERSION=2.1.0
ENVIRONMENT=production

# Replace CHANGE_ME with the Ingress IP or domain after the first deploy.
RSS_BASE_URL=http://CHANGE_ME
ALLOWED_ORIGINS=["http://CHANGE_ME","http://localhost:3000","http://127.0.0.1:3000"]

POSTGRES_USER=jobsrss
POSTGRES_PASSWORD=jobsrss
POSTGRES_DB=jobsrss
DATABASE_URL=postgresql+psycopg2://jobsrss:jobsrss@postgres:5432/jobsrss

BACKEND_API_BASE_URLS=http://api:8000

SCHEDULER_ENABLED=true
SCHEDULER_COMPANY_INTERVAL_MINUTES=20
SCHEDULER_PLATFORM_INTERVAL_MINUTES=20
SCHEDULER_LINKEDIN_EMAIL_INTERVAL_MINUTES=15
HIGH_MATCH_THRESHOLD=80

OFFICIAL_SOURCES_ENABLED=true
OFFICIAL_SOURCE_INTERVAL_MINUTES=20
OFFICIAL_SOURCE_VERIFY_TLS=false

# GKE datacenter IPs usually get LinkedIn/Liepin session blocks.
# Keep cookies under /secrets and turn these on only if you accept that risk.
LINKEDIN_AUTH_ENABLED=false
LINKEDIN_REQUIRE_STORAGE_STATE=true
LINKEDIN_AUTH_STORAGE_STATE_PATH=/secrets/linkedin_state.json
LINKEDIN_STRICT_LOCATION_FILTER=true
LINKEDIN_ALLOWED_LOCATIONS=Singapore,Hong Kong,Shanghai,Jiangsu,Zhejiang
LINKEDIN_SEARCH_URLS=https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security%20Architect&location=Hong%20Kong,https://www.linkedin.com/jobs/search/?keywords=Cloud%20Security%20Engineer&location=Singapore,https://www.linkedin.com/jobs/search/?keywords=Security%20Architect&location=Shanghai

LINKEDIN_EMAIL_ENABLED=false
LINKEDIN_EMAIL_IMAP_HOST=imap.gmail.com
LINKEDIN_EMAIL_IMAP_PORT=993
LINKEDIN_EMAIL_USERNAME=jobs-alert@example.com
LINKEDIN_EMAIL_PASSWORD=your_app_password
LINKEDIN_EMAIL_FOLDER=INBOX
LINKEDIN_EMAIL_SENDER_FILTER=jobs-noreply@linkedin.com
SCHEDULER_LINKEDIN_EMAIL_MAX_MESSAGES=30

LIEPIN_AUTH_ENABLED=false
LIEPIN_AUTH_STORAGE_STATE_PATH=/secrets/liepin_state.json
LIEPIN_SEARCH_URLS=https://www.liepin.com/zhaopin/?city=410&dq=410&pubTime=&currentPage=0&pageSize=40&key=security&suggestTag=&workYearCode=0&compId=&compName=&compTag=&industry=&salaryCode=&jobKind=&compScale=&compKind=&compStage=&eduLevel=&otherCity=&ckId=ko9w4gjths4fq8vru86ni0ggiw6qzzlb&skId=ko9w4gjths4fq8vru86ni0ggiw6qzzlb&fkId=ko9w4gjths4fq8vru86ni0ggiw6qzzlb&scene=input&sfrom=search_job_pc&suggestId=

LLM_RERANK_ENABLED=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://foundry0805.openai.azure.com/openai/v1
LLM_MODEL=gpt-5.6-luna
LLM_API_VERSION=
LLM_AZURE_USE_DEFAULT_CREDENTIAL=false
LLM_AZURE_SCOPE=https://ai.azure.com/.default
LLM_TIMEOUT_SECONDS=30
LLM_VERIFY_TLS=true
LLM_REQUEST_MAX_RETRIES=2
LLM_REQUEST_RETRY_BACKOFF_SECONDS=1.5
LLM_ABORT_AFTER_CONSECUTIVE_FAILURES=8
LLM_RERANK_INTERVAL_MINUTES=30
LLM_MIN_RULE_SCORE=20
LLM_ONLY_UNSCORED=false
LLM_MAX_JOBS_PER_RUN=500
LLM_TARGET_PROFILE=Senior cybersecurity roles focused on cloud security, application security, IAM/PAM, SOC/SIEM, threat detection, vulnerability management, and security architecture leadership across Shanghai/Jiangsu/Zhejiang (Yangtze River Delta), Hong Kong, and Singapore.
