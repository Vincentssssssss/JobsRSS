pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    GCP_PROJECT_ID = credentials('gcp-project-id')
    GCP_REGION = credentials('gcp-region')
    GKE_CLUSTER = credentials('gke-cluster')
    AR_REPOSITORY = 'jobsrss'
    IMAGE_TAG = "${env.GIT_COMMIT}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Backend Tests') {
      steps {
        sh '''
          python3 -m venv .venv-ci
          . .venv-ci/bin/activate
          python -m pip install --upgrade pip
          pip install -r backend/requirements.txt pytest
          PYTHONPATH=backend pytest backend/tests
        '''
      }
    }

    stage('Frontend Build') {
      steps {
        dir('frontend') {
          sh 'npm ci --no-audit --no-fund'
          sh 'npm run build'
        }
      }
    }

    stage('Build & Push Images') {
      steps {
        withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            gcloud auth activate-service-account --key-file="$GOOGLE_APPLICATION_CREDENTIALS"
            gcloud config set project "$GCP_PROJECT_ID"
            AR_HOST="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPOSITORY}"
            gcloud auth configure-docker "${GCP_REGION}-docker.pkg.dev" --quiet

            docker build -t "$AR_HOST/jobsrss-api:$IMAGE_TAG" -f backend/Dockerfile backend
            docker build -t "$AR_HOST/jobsrss-api:latest" -f backend/Dockerfile backend
            docker push "$AR_HOST/jobsrss-api:$IMAGE_TAG"
            docker push "$AR_HOST/jobsrss-api:latest"

            docker build -t "$AR_HOST/jobsrss-frontend:$IMAGE_TAG" -f frontend/Dockerfile frontend
            docker build -t "$AR_HOST/jobsrss-frontend:latest" -f frontend/Dockerfile frontend
            docker push "$AR_HOST/jobsrss-frontend:$IMAGE_TAG"
            docker push "$AR_HOST/jobsrss-frontend:latest"
          '''
        }
      }
    }

    stage('Deploy to GKE') {
      steps {
        withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            gcloud auth activate-service-account --key-file="$GOOGLE_APPLICATION_CREDENTIALS"
            gcloud container clusters get-credentials "$GKE_CLUSTER" \
              --region "$GCP_REGION" \
              --project "$GCP_PROJECT_ID"
            AR_HOST="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPOSITORY}"
            IMAGE_API="$AR_HOST/jobsrss-api:$IMAGE_TAG" \
            IMAGE_FRONTEND="$AR_HOST/jobsrss-frontend:$IMAGE_TAG" \
              bash deploy/gke/scripts/apply-workloads.sh
          '''
        }
      }
    }
  }
}
